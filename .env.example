# --- Horde configuration ---
# Copy to .env and adjust for your TrueNAS server.

# UID/GID of the TrueNAS user that owns the media dataset. Find it in
# TrueNAS under Credentials > Local Users (or run `id <user>` on the shell).
# The container writes downloads and the database as this user so files are
# readable/writable over SMB and not owned by root.
PUID=1000
PGID=1000

# Host path to your ZFS dataset for media. Create this dataset first, e.g.
# /mnt/tank/media/youtube_archive
DOWNLOADS_PATH=/mnt/tank/media/youtube_archive

# Host path for persistent app data (SQLite DB, app_settings.json, cached
# thumbnails). This must survive container restarts and git pull. Keep it in
# .env — do not hardcode the path only in docker-compose.yml. Prefer a
# directory on your data pool, not inside the git clone, e.g.
# /mnt/tank/apps/horde/data
#
# DATA_PATH MUST be a LOCAL disk or dataset (ZFS, ext4, xfs, ...). It holds a
# SQLite database in WAL mode, which is NOT safe on SMB/NFS/network mounts and
# can corrupt. Only DOWNLOADS_PATH may live on a network share.
#
# The TrueNAS-style defaults in this file (and in docker-compose.yml) do not
# exist on other machines. Docker will silently create them as root-owned
# folders, and Horde then cannot write. Always set both paths to directories
# you created and that PUID:PGID owns.
DATA_PATH=/opt/dockge/horde/data

# How often (seconds) the fallback poller rescans the media folder for
# manually dropped files. ZFS network mounts sometimes drop inotify events,
# so this guarantees new files are picked up.
SCAN_INTERVAL_SEC=60
# Log level (DEBUG, INFO, WARNING, ERROR) and format (text or json, one object per line).
# HORDE_LOG_LEVEL=INFO
# HORDE_LOG_FORMAT=text
# Request threads allowed inside yt-dlp work at once, and how long a call waits its turn.
# HORDE_YTDLP_REQUEST_THREADS=8
# HORDE_EXTRACT_QUEUE_TIMEOUT_SEC=180
# HORDE_EXTRACT_QUEUE_TIMEOUT_BACKGROUND_SEC=540  (unset or empty = 3x the value above)
# Live streams of followed channels: seconds between checks of a channel (0 = off),
# seconds between two checks, and how many hours back the player can scrub.
# HORDE_LIVE_POLL_SEC=300
# HORDE_LIVE_POLL_SPACING_SEC=2
# HORDE_LIVE_DVR_HOURS=4
# Nightly database backup to DATA_DIR/backups: on/off (1/0), local hour (0-23) and how many to keep (min 1).
# HORDE_BACKUP_ENABLED=1
# HORDE_BACKUP_HOUR=4
# HORDE_BACKUP_KEEP=7
# Boot sweep: delete stale .part/.ytdl/temp files and finished-job staging older than N hours (0 = off).
# HORDE_TEMP_SWEEP_HOURS=6
# Days to keep AI results (summary, chapters, chat) of a streamed video nobody reopened or downloaded.
# HORDE_STREAM_AI_RETENTION_DAYS=30

# YouTube bot checks — Docker Compose starts a bgutil POT sidecar automatically.
# Tokens are generated on demand; no manual rotation needed.
# YTDLP_POT_BASE_URL=http://bgutil-pot:4416

# Optional cookies for age-restricted / members-only videos you can watch signed-in.
# Horde leaves them off public requests and only attaches them after that one video is blocked.
# YTDLP_COOKIE_FILE=/path/to/youtube_cookies.txt
# YTDLP_COOKIES_FROM_BROWSER=firefox
# YTDLP_COOKIES_FROM_BROWSER=chrome:Default

# --- Optional AI (Ollama) ---
# Start the sidecar: docker compose --profile ai up -d
# Or point at Ollama on another host (e.g. a gaming PC with a GPU):
# OLLAMA_BASE_URL=http://192.168.1.50:11434
# OLLAMA_DATA_PATH=/opt/dockge/horde/ollama
# When OLLAMA_BASE_URL is empty, Horde auto-discovers http://ollama:11434
# then http://host.docker.internal:11434.

# --- Optional AI (OpenRouter) ---
# Cloud LLM for summaries, chat, tag enrich, and duplicate confirmation.
# Overrides the key in Settings → AI when set. Enable OpenRouter in Settings.
# OPENROUTER_API_KEY=sk-or-v1-…

# --- Container hardening (optional) ---
# The container refuses to run as root (PUID=0 / PGID=0). Set to 1 only if you
# really want that.
# HORDE_ALLOW_ROOT=0
# Memory cap for the horde container (e.g. 4g). Empty/0 = unlimited (default).
# Transcoding and sprite generation can use a lot of RAM; only set a limit you
# have tested.
# HORDE_MEM_LIMIT=
# Maximum processes/threads in the container.
# HORDE_PIDS_LIMIT=1024

# --- yt-dlp runtime updater (optional, off by default) ---
# 1 = on every container start, install the newest yt-dlp into
# $DATA_PATH/pylib and prefer it over the version baked into the image. Lets you
# fix a YouTube breakage with a restart instead of waiting for a new release.
# Trade-off: the container contacts PyPI at start and runs an unreviewed,
# newer yt-dlp than the one tested for this release. Failures are logged and
# never stop startup.
# YTDLP_AUTO_UPDATE=0

# --- Build options (optional) ---
# ffmpeg flavor baked into the image: jellyfin (default; hardware encoders) or
# debian. The build fails if the flavor cannot be installed.
# FFMPEG_FLAVOR=jellyfin
# Supply-chain check for the jellyfin flavor: the build fails unless the
# downloaded Jellyfin repository signing key has exactly this fingerprint
# (40 hex characters, no spaces). The Dockerfile pins the current key by
# default; override only if Jellyfin rotates their key, after verifying the new
# fingerprint out of band.
# JELLYFIN_GPG_FPR=4918AABC486CA052358D778D49023CD01DE21A7B

# --- Published image instead of building from source (optional) ---
# See docs: Getting started -> Updating -> "Use the published image".
# HORDE_IMAGE=ghcr.io/jm-connell/horde:latest
# HORDE_PULL_POLICY=always

# --- Updates (optional) ---
# Which version `bash update.sh` installs: release (default; the newest stable
# vX.Y.Z tag), prerelease (also -rc tags) or main (every commit on main).
# HORDE_UPDATE_CHANNEL=release
# Allow update.sh to switch to a release OLDER than your checkout (a database
# migrated by newer code may not start on older code):
# HORDE_ALLOW_DOWNGRADE=1
# Prefer: bash update.sh  (from the stack folder on the host)
# Or pass the git SHA at build time manually:
#   sudo HORDE_GIT_SHA=$(git rev-parse HEAD) docker compose build horde
# HORDE_GIT_SHA=
# Override the GitHub repo used for update checks (owner/name). This is a
# runtime setting read by the app, not baked into the image:
# HORDE_GITHUB_REPO=jm-connell/horde

# --- Accounts (optional; see docs/ops/authentication.md) ---
# Lost the admin password? docker exec -it horde python -m app.cli reset-password <user>
# Trust X-Forwarded-For / X-Forwarded-Proto from a reverse proxy you control
# (client address for login rate limiting, Secure cookie flag):
# HORDE_TRUST_PROXY=1
# Proxies that append to X-Forwarded-For (the client is counted from the right):
# HORDE_TRUSTED_PROXY_HOPS=1
# DANGER: turn the login off because a reverse proxy in front already
# authenticates users. Every request then acts as the first admin.
# HORDE_AUTH_DISABLED=1
# Needs HORDE_TRUST_PROXY=1 (Horde refuses to start otherwise). Act as the existing Horde user named in this header.
# HORDE_TRUSTED_USER_HEADER=X-Remote-User

# --- Security (optional; see docs/ops/security.md) ---
# Horde only answers requests whose Host header is a LAN-style name: localhost,
# private / link-local / Tailscale IPs, single-word names (truenas) and *.local,
# *.lan, *.home.arpa, *.internal, *.ts.net. Behind a reverse proxy on a public
# name, list that name here (comma separated, "*.example.com" wildcards allowed).
# The list adds to the defaults. "*" turns the check off (not recommended).
# Required after upgrading if you reach Horde through a proxy or tunnel: without it
# browsers get 400 host_not_allowed (a startup warning appears when
# HORDE_TRUST_PROXY=1 and this is empty).
# HORDE_ALLOWED_HOSTS=horde.example.com
# Server-side fetches (thumbnails, yt-dlp link checks) refuse loopback, private and
# link-local addresses. Set to 1 only if you download from LAN sources (a NAS,
# a local media server).
# HORDE_ALLOW_PRIVATE_URLS=1
# Largest video file the Import page accepts, in GB (default 50). Imports also
# keep 1 GB of disk free.
# HORDE_MAX_UPLOAD_GB=50
